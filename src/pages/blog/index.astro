---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import BlogCard from '../../components/BlogCard.astro';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Blog - Jeff" description="Thoughts on AI-first product development, calm interfaces, and building digital products that actually serve their users.">
	<main class="blog-page">
		<div class="blog-header">
			<h1>Thoughts & Insights</h1>
			<p class="blog-subtitle">
				Reflections on AI-first development, calm interfaces, and the art of building 
				digital products that help people think, not just consume.
			</p>
		</div>

		<div class="blog-grid">
			{sortedPosts.map((post) => (
				<BlogCard post={post} />
			))}
		</div>

		{sortedPosts.length === 0 && (
			<div class="empty-state">
				<h3>Coming Soon</h3>
				<p>I'm working on some thoughtful content about AI-first product development. Check back soon!</p>
			</div>
		)}
	</main>
</Layout>

<style>
	.blog-page {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem;
	}

	.blog-header {
		text-align: center;
		margin-bottom: 4rem;
		padding: 2rem 0;
	}

	.blog-header h1 {
		font-size: 2.5rem;
		font-weight: 300;
		margin-bottom: 1rem;
		color: var(--text-primary);
	}

	.blog-subtitle {
		font-size: 1.1rem;
		color: var(--text-secondary);
		max-width: 600px;
		margin: 0 auto;
		line-height: 1.6;
	}

	.blog-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
		gap: 2rem;
	}

	.empty-state {
		text-align: center;
		padding: 4rem 2rem;
		color: var(--text-secondary);
	}

	.empty-state h3 {
		font-size: 1.5rem;
		margin-bottom: 1rem;
		color: var(--text-primary);
	}

	@media (max-width: 768px) {
		.blog-page {
			padding: 1rem;
		}
		
		.blog-header h1 {
			font-size: 2rem;
		}
		
		.blog-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

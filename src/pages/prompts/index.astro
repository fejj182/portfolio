---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const prompts = await getCollection('prompts');
const sortedPrompts = prompts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout title="Prompts - Jeff" description="A journal of AI prompts and their outcomes in my development process.">
	<main class="prompts-page">
		<div class="prompts-header">
			<h1>Prompt Journal</h1>
			<p class="prompts-subtitle">
				A systematic approach to documenting AI interactions, capturing both the prompts 
				and their outcomes to build a knowledge base of effective development patterns.
			</p>
		</div>

		{sortedPrompts.length > 0 && (
			<section class="prompts-list">
				<div class="prompts-grid">
					{sortedPrompts.map(async (prompt) => {
						const { Content } = await render(prompt);
						return (
							<article class="prompt-card">
								<div class="prompt-header">
									<h2 class="prompt-title">{prompt.data.title}</h2>
									<time class="prompt-date" datetime={prompt.data.date.toISOString()}>
										{prompt.data.date.toLocaleDateString('en-US', { 
											year: 'numeric', 
											month: 'long', 
											day: 'numeric' 
										})}
									</time>
								</div>
								<div class="prompt-content">
									<Content />
								</div>
							</article>
						);
					})}
				</div>
			</section>
		)}

		{sortedPrompts.length === 0 && (
			<div class="empty-state">
				<h3>No Prompts Yet</h3>
				<p>Start documenting your AI interactions to build a knowledge base of effective patterns.</p>
			</div>
		)}
	</main>
</Layout>

<style>
	.prompts-page {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem;
	}

	.prompts-header {
		text-align: center;
		margin-bottom: 4rem;
		padding: 2rem 0;
	}


	.prompts-subtitle {
		max-width: 600px;
		margin: 0 auto;
	}

	.prompts-grid {
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	.prompt-card {
		background: var(--gradient-secondary);
		border-radius: 12px;
		padding: 2rem;
		border: 1px solid var(--border-color);
		transition: all 0.3s ease;
		position: relative;
		overflow: hidden;
	}

	.prompt-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 3px;
		background: var(--gradient-primary);
		opacity: 0;
		transition: opacity 0.3s ease;
	}

	.prompt-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-lg);
	}

	.prompt-card:hover::before {
		opacity: 1;
	}

	.prompt-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 1rem;
	}

	.prompt-title {
		font-weight: 500;
		margin: 0;
		flex: 1;
	}

	.prompt-date {
		white-space: nowrap;
	}

	.prompt-content pre {
		background: var(--gradient-secondary);
		border: 1px solid var(--border-color);
		border-radius: 8px;
		padding: 1.5rem;
		font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
		white-space: pre-wrap;
		overflow-x: auto;
		margin: 1rem 0;
		box-shadow: var(--shadow-sm);
	}

	.prompt-content code {
		background: var(--gradient-primary);
		color: white;
		border: none;
		border-radius: 4px;
		padding: 0.2rem 0.4rem;
		font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
		font-size: 0.9em;
	}

	.prompt-content blockquote {
		border-left: 4px solid;
		border-image: var(--gradient-primary) 1;
		padding-left: 1rem;
		margin: 1rem 0;
		font-style: italic;
		background: var(--gradient-secondary);
		padding: 1rem;
		border-radius: 0 8px 8px 0;
	}

	.empty-state {
		text-align: center;
		padding: 4rem 2rem;
	}


	@media (max-width: 768px) {
		.prompts-page {
			padding: 1rem;
		}
		
		.prompt-header {
			flex-direction: column;
			align-items: flex-start;
		}
		
		.prompt-date {
			white-space: normal;
		}
	}
</style>

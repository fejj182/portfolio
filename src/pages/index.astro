---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Jeff - AI-First Product Engineer">
	<main class="home">
		<section class="hero">
			<div class="hero-content">
				<h1>Building AI first digital products</h1>
				<p class="hero-subtitle">
					Product Engineer - Tech Lead - Indie Entrepreneur
				</p>
				<div class="hero-links">
					<a href="/projects" class="btn-primary">See my work</a>
				</div>
			</div>
		</section>

		<section id="about" class="about">
			<div class="about-content">
				<h2>About</h2>
				<p>
					We are at the beginning of the AI first software revolution. I'm a product engineer who believes in 
					using this technology to help us build high quality digital products that serve their users and solve real problems.
				</p>
				<p>
					Based in Mataró, a sleeping giant near Barcelona, Spain. When I'm not coding, I'm hanging out with my amazing partner
					and our newborn son. We love to enjoy the sunshine, the beach and eat whatever tasty things we can find.
				</p>
			</div>
		</section>


	</main>
</Layout>

<style>
	.home {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	.hero {
		padding: 4rem 0 6rem;
		text-align: center;
	}

	.hero h1 {
		margin-bottom: 1.5rem;
	}

	.hero-subtitle {
		margin-bottom: 3rem;
		max-width: 600px;
		margin-left: auto;
		margin-right: auto;
		font-size: 1.2rem;
		font-weight: 400;
		color: var(--text-secondary);
		line-height: 1.6;
		background: linear-gradient(135deg, var(--text-secondary) 0%, var(--accent-color) 100%);
		background-clip: text;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		text-shadow: 0 2px 4px rgba(139, 92, 246, 0.1);
	}

	.hero-links {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.about {
		padding: 4rem 0;
		border-top: 1px solid var(--border-color);
	}

	.about-content {
		max-width: 800px;
		margin: 0 auto;
	}


	@media (max-width: 768px) {
		.hero-links {
			flex-direction: column;
			align-items: center;
		}
	}
</style>

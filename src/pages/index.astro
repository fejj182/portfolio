---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Jeff - AI-First Product Engineer">
	<main class="home">
		<section class="hero">
			<div class="hero-content">
				<h1>Building thoughtful digital products with AI</h1>
				<p class="hero-subtitle">
					Product engineer crafting calm, intelligent interfaces that help you think, not just publish.
				</p>
				<div class="hero-links">
					<a href="/projects" class="btn-primary">See my work</a>
				</div>
			</div>
		</section>

		<section id="about" class="about">
			<div class="about-content">
				<h2>About</h2>
				<p>
					I'm a product engineer who believes in the power of AI-first development to create 
					digital products that actually serve their users. Based in Spain, I focus on building 
					systems that front-load clarity over chaos, with interfaces that lower nervous system 
					activation rather than chase dopamine hits.
				</p>
				<p>
					When I'm not coding, you'll find me appreciating the strategic precision of football, 
					snooker, padel, and poker. I value flow states and the quiet confidence that comes 
					from thoughtful preparation.
				</p>
			</div>
		</section>


	</main>
</Layout>

<style>
	.home {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	.hero {
		padding: 4rem 0 6rem;
		text-align: center;
	}

	.hero h1 {
		margin-bottom: 1.5rem;
	}

	.hero-subtitle {
		margin-bottom: 3rem;
		max-width: 600px;
		margin-left: auto;
		margin-right: auto;
	}

	.hero-links {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.about {
		padding: 4rem 0;
		border-top: 1px solid var(--border-color);
	}

	.about-content {
		max-width: 800px;
		margin: 0 auto;
	}


	@media (max-width: 768px) {
		.hero-links {
			flex-direction: column;
			align-items: center;
		}
	}
</style>
